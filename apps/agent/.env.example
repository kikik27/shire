# ──────────────────────────────────────────────────────────────────────────────
# Shire Agent — environment configuration
#
# The agent is the LLM orchestration + matching service. It:
#   - serves /chat/:agentId, /product-qna, /jobs/* (Express + Mastra)
#   - runs the matching pipeline (Filter -> Rule Score -> Rerank) as BullMQ jobs
#   - reads candidate/job profiles + writes recommendations to the SAME Postgres
#     that apps/web owns (SHIRE_AGENT_DATABASE_URL)
#
# Generate the service token once and set the IDENTICAL value in apps/web/.env
# SHIRE_AGENT_SERVICE_TOKEN. The web app authenticates proxy requests with it:
#   node -e "console.log('shire_'+require('crypto').randomBytes(24).toString('hex'))"
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3010

# Optional durable job queue. When unset, an in-memory queue is used (jobs do
# not persist across restarts). Recommended for production.
REDIS_URL=rediss://user:password@redis.example.com:6379

# Shared secret with apps/web. MUST match apps/web/.env exactly.
SHIRE_AGENT_SERVICE_TOKEN=replace-with-a-long-random-secret

# Postgres shared with apps/web. In standard deployments this is the SAME value
# as apps/web/.env DATABASE_URL (the pooled Neon connection). Required for
# job-matching / talent-matching jobs; the agent keeps serving chat without it.
SHIRE_AGENT_DATABASE_URL=postgresql://user:password@host:5432/shire
SHIRE_JOB_QUEUE_NAME=shire-agent-jobs
SHIRE_JOB_ATTEMPTS=3
SHIRE_JOB_BACKOFF_MS=5000
SHIRE_CV_MAX_FILE_BYTES=5242880

SHIRE_AUTONOMY_MODE=semi-autonomous
SHIRE_LOG_LEVEL=debug
SHIRE_PRETTY_LOGS=true
SHIRE_MODEL_DEFAULT=openrouter/nex-agi/nex-n2-pro:free,openrouter/openai/gpt-oss-20b:free
SHIRE_MODEL_PRODUCT_QNA=openrouter/nex-agi/nex-n2-pro:free
SHIRE_MODEL_ROLE_AWARE_CHAT=openrouter/nex-agi/nex-n2-pro:free
SHIRE_MODEL_CV_NORMALIZATION=openrouter/openai/gpt-oss-20b:free
SHIRE_MODEL_KNOWLEDGE_SYNTHESIS=openrouter/nex-agi/nex-n2-pro:free
SHIRE_MODEL_JOB_RERANK=openrouter/nex-agi/nex-n2-pro:free
SHIRE_MODEL_TALENT_RERANK=openrouter/nex-agi/nex-n2-pro:free
SHIRE_MODEL_RECOMMENDATION_EXPLANATION=openrouter/nex-agi/nex-n2-pro:free
SHIRE_MODEL_WORKFLOW_SUMMARY=openrouter/nex-agi/nex-n2-pro:free
SHIRE_MODEL_DISPUTE_SUMMARY=openrouter/openai/gpt-oss-20b:free
SHIRE_MODEL_SECURITY_GUARD=openrouter/nex-agi/nex-n2-pro:free
SHIRE_EMBEDDING_MODEL_DEFAULT=qwen/qwen3-embedding-8b
SHIRE_EMBEDDING_MODEL_MEMORY=qwen/qwen3-embedding-8b
SHIRE_EMBEDDING_MODEL_PRODUCT_KNOWLEDGE=qwen/qwen3-embedding-8b
SHIRE_EMBEDDING_MODEL_REPOSITORY_KNOWLEDGE=qwen/qwen3-embedding-8b
SHIRE_EMBEDDING_BASE_URL_DEFAULT=https://openrouter.ai/api/v1
SHIRE_EMBEDDING_BASE_URL_MEMORY=https://openrouter.ai/api/v1
SHIRE_EMBEDDING_BASE_URL_PRODUCT_KNOWLEDGE=https://openrouter.ai/api/v1
SHIRE_EMBEDDING_BASE_URL_REPOSITORY_KNOWLEDGE=https://openrouter.ai/api/v1
SHIRE_EMBEDDING_ENABLED=true
SHIRE_WORKING_MEMORY_ENABLED=false
SHIRE_WORKER_ENABLED=true
SHIRE_LIVE_LLM_TESTS=false

SHIRE_CHAT_MAX_BODY_BYTES=65536
SHIRE_CHAT_MAX_MESSAGES=50
SHIRE_CHAT_MAX_MESSAGE_CHARACTERS=8000
SHIRE_CHAT_RATE_LIMIT_REQUESTS=30
SHIRE_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
SHIRE_SECURITY_GUARD_ENABLED=true
SHIRE_SECURITY_GUARD_MODE=suspicious-only
SHIRE_SECURITY_GUARD_MODELS=openrouter/openai/gpt-oss-20b:free,openrouter/nex-agi/nex-n2-pro:free
SHIRE_SECURITY_GUARD_THRESHOLD=0.85
SHIRE_OUTPUT_MAX_CHARACTERS=12000

SHIRE_AGENT_MEMORY_URL=file:./.data/shire-agent-memory.db
SHIRE_AGENT_MEMORY_AUTH_TOKEN=
SHIRE_AGENT_KNOWLEDGE_URL=file:./.data/shire-agent-knowledge.db
SHIRE_AGENT_KNOWLEDGE_AUTH_TOKEN=
SHIRE_AGENT_KNOWLEDGE_MANIFEST_URL=file:./.data/shire-agent-knowledge.db
SHIRE_AGENT_KNOWLEDGE_MANIFEST_AUTH_TOKEN=
SHIRE_AGENT_KNOWLEDGE_INDEX=shire_context
SHIRE_RAG_TOP_K=5
SHIRE_RAG_MAX_CHARACTERS=8000

OPENROUTER_API_KEY=
