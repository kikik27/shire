# ──────────────────────────────────────────────────────────────────────────────
# Shire Web — environment configuration
#
# The web app is the Next.js frontend. It owns the Postgres database (Drizzle)
# and proxies LLM/matching work to the agent service via the routes under
# /app/api. It authenticates every proxy request with the shared service token.
#
# The agent (apps/agent) connects to the SAME Postgres via SHIRE_AGENT_DATABASE_URL
# to run the matching pipeline and write recommendations back here.
# ──────────────────────────────────────────────────────────────────────────────

# Privy — auth + embedded wallets (https://dashboard.privy.io).
# When BOTH are unset, the app falls back to a client-side demo wallet so it
# still runs locally. Set both for real authentication.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Agent service endpoints + shared server-only credential.
# SHIRE_AGENT_SERVICE_TOKEN MUST match apps/agent/.env exactly. Generate once:
#   node -e "console.log('shire_'+require('crypto').randomBytes(24).toString('hex'))"
SHIRE_AGENT_CHAT_URL=http://localhost:3010/chat/role-aware-chat-agent
SHIRE_AGENT_INTERNAL_URL=http://localhost:3010
SHIRE_AGENT_SERVICE_TOKEN=replace-with-the-same-long-random-secret-as-agent

# Hosted Postgres (server-only; never add NEXT_PUBLIC_ prefixes).
# Runtime: pooled connection string for the application.
DATABASE_URL=postgresql://APP_USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
# Migrations: owner/direct URL. On Neon, use the unpooled connection string.
DIRECT_DATABASE_URL=postgresql://OWNER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
