{
  "name": "shire",
  "private": true,
  "packageManager": "npm@11.3.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build --filter=@shire/agent --filter=@shire/web",
    "build:contracts": "npm run build --workspace=@shire/solidity",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=@shire/agent --filter=@shire/web",
    "test:contracts": "npm run test --workspace=@shire/solidity",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "turbo": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
